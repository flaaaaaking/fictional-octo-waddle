# 复制为 .env。不要提交真实值。
PORT=3000
SESSION_SECRET=请替换为至少32字节随机字符串

# mock 可直接运行；填好密钥后改成 deepseek
AI_PROVIDER=mock
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 费用保护
DAILY_CODE_LIMIT=10
MAX_TURNS_PER_SESSION=66
# 访问码可反复回来查看原结果；默认十年续期
SESSION_TTL_HOURS=87600
