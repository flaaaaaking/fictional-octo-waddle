# Copy this file to .env. Never commit real values.
# Mock runs without any provider cost; change to deepseek only after filling the key.
AI_PROVIDER=mock
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io
DAILY_CODE_LIMIT=10
MAX_TURNS_PER_SESSION=66
# Ten years controls returning users only; it does not change the daily new-user limit.
SESSION_TTL_HOURS=87600
SESSION_SECRET=replace-with-a-long-random-secret
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=4200
